# Server Port
PORT=8080

# PostgreSQL Connection String
DATABASE_URL=postgres://walkie:walkie_dev_password@localhost:5432/walkie
POSTGRES_PASSWORD=walkie_dev_password

# JWT Secret (Generate a strong random 64-char hex string in production)
JWT_SECRET=replace_with_64_char_random_secret

# LiveKit Server Credentials (Must match livekit.yaml keys)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_change_me_in_production_min_32_chars
# Public WebSocket URL reachable by Android clients (use wss://your-domain.com in production)
LIVEKIT_PUBLIC_URL=ws://10.0.2.2:7880

# TURN Server (Coturn) Credentials for strict cellular/NAT traversal
TURN_USER=walkie
TURN_PASS=walkie_turn_secret
TURN_REALM=walkie.example.com

# Firebase Cloud Messaging Admin SDK Service Account (Optional for local dev, required for wake push alerts)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
